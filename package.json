{
  "name": "dsh-kb",
  "version": "0.1.0",
  "description": "本机长期记忆库 for DeepSeek Harness：把每次会话里想明白的事沉淀成不可变事实卡，用骨架树做分类、关系图做脉络、FTS5 做检索。零外部依赖（node:sqlite + node:zlib），提供 kb_search / kb_add / kb_tree / kb_stats 四个原生工具。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-kb": "./bin/kb.js"
  },
  "files": [
    "lib/**/*.js",
    "bin/kb.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "knowledge-base",
    "local-first",
    "sqlite",
    "fts5"
  ],
  "license": "MIT",
  "author": "Hughes <825669638@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MyRemme/dsh-kb.git"
  },
  "bugs": {
    "url": "https://github.com/MyRemme/dsh-kb/issues"
  },
  "homepage": "https://github.com/MyRemme/dsh-kb#readme",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1"
  }
}
